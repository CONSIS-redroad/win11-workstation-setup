<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obraz dysku - backup i przywracanie"
        Height="720" Width="480" MinHeight="600" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="#131313" FontFamily="Segoe UI" Foreground="#E5E2E1">
  <Window.Resources>
    <Style TargetType="Button" x:Key="PrimaryBtn">
      <Setter Property="Background" Value="#0078D4"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="GhostBtn">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#E5E2E1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#C0C7D4"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#202020" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="20,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="36" Height="36" CornerRadius="8" Background="#005A9E" VerticalAlignment="Center">
            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Obraz systemu" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Name="txtSubtitle" Text="Windows Backup (wbadmin)" FontSize="11" Foreground="#9CA3AF"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,0">
      <TabItem Header="Utworz obraz">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,8">
          <StackPanel>
            <TextBlock Text="Zapisz caly dysk C: (+ partycje krytyczne) na zewnetrzny nosnik. Nie uzywamy sysprep."
                       TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,16"/>

            <TextBlock Text="Nosnik docelowy (nie C:)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox Name="cmbBackupTarget" Height="36" Background="#2A2A2A" Foreground="#E5E2E1"
                      DisplayMemberPath="Display" SelectedValuePath="Letter"/>

            <TextBlock Name="txtBackupSpace" Text="" TextWrapping="Wrap" Foreground="#74D1FF" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock Name="txtCEstimate" Text="" TextWrapping="Wrap" Foreground="#C0C7D4" FontSize="11" Margin="0,6,0,0"/>

            <CheckBox Name="chkRestorePoint" Content="Punkt przywracania przed backupem" IsChecked="True" Margin="0,16,0,0"/>
            <CheckBox Name="chkConfirmBackup" Content="Rozumiem: backup moze trwac dlugo" Margin="0,8,0,0"/>

            <Button Name="btnRefreshVolumes" Style="{StaticResource GhostBtn}" Content="Odswiez liste dyskow"
                    HorizontalAlignment="Left" Margin="0,16,0,0"/>

            <Button Name="btnStartBackup" Style="{StaticResource PrimaryBtn}" Content="Rozpocznij backup"
                    Margin="0,20,0,0" IsEnabled="False"/>

            <TextBlock Text="Postep" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <ProgressBar Name="barBackup" Height="8" Minimum="0" Maximum="100" Value="0"
                         Background="#2A2A2A" Foreground="#0078D4" BorderThickness="0"/>
            <TextBlock Name="txtBackupPct" Text="Gotowy" FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0"/>
            <TextBlock Name="txtBackupStatus" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#C0C7D4" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Przywroc">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,8">
          <StackPanel>
            <TextBlock Text="Przywracanie najbezpieczniej z Windows RE (srodowisko odzyskiwania). Tutaj: podglad wersji i skroty."
                       TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,16"/>

            <TextBlock Text="Nosnik z obrazem" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox Name="cmbRestoreSource" Height="36" Background="#2A2A2A" Foreground="#E5E2E1"
                      DisplayMemberPath="Display" SelectedValuePath="Letter"/>

            <Button Name="btnLoadVersions" Style="{StaticResource GhostBtn}" Content="Wczytaj wersje obrazu"
                    HorizontalAlignment="Left" Margin="0,12,0,0"/>

            <ListBox Name="lstVersions" Height="140" Margin="0,12,0,0" Background="#1B1C1C" BorderBrush="#333"
                     Foreground="#E5E2E1"/>

            <TextBlock Text="Komenda recovery nadpisze C:. Panel jej nie uruchamia - tylko kopiuje. Bezpieczniej: Windows RE." FontSize="11" Foreground="#FFB4AB"
                       Margin="0,12,0,6" TextWrapping="Wrap"/>
            <TextBox Name="txtRecoveryCmd" IsReadOnly="True" TextWrapping="Wrap" Height="56"
                     Background="#1B1C1C" Foreground="#C0C7D4" BorderBrush="#333" FontFamily="Consolas" FontSize="11"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Name="btnCopyRecovery" Style="{StaticResource GhostBtn}" Content="Kopiuj komende"/>
              <Button Name="btnOpenRecovery" Style="{StaticResource PrimaryBtn}" Content="Ustawienia odzyskiwania" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Zalecane: Ustawienia → System → Odzyskiwanie → Przywroc obraz systemu (restart do RE)."
                       TextWrapping="Wrap" FontSize="11" Foreground="#7ADA95" Margin="0,16,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Pomoc">
        <ScrollViewer Padding="0,12,0,8">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#C0C7D4" LineHeight="20">
              1. Po dopieciu profilu zrob ai.bat dump i commit JSON.
              2. Backup na SSD/USB (NTFS), min. ~40 GB wolne.
              3. Za kwartal: przywroc obraz, potem git pull, ai.bat upgrade, pip.
              Bez sysprep — Docker i CAD zostaja na miejscu.
            </TextBlock>
            <Button Name="btnOpenDocs" Style="{StaticResource GhostBtn}" Content="Otworz OBRAZ-DYSKU.md"
                    HorizontalAlignment="Left" Margin="0,16,0,0"/>
            <Button Name="btnOpenMainPanel" Style="{StaticResource GhostBtn}" Content="Pelny ConsisAI (start.bat)"
                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#202020" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="16,10">
      <TextBlock Name="txtFooter" Text="Wymaga Administratora. Obraz nie trafia do gita." FontSize="10" Foreground="#6B7280"/>
    </Border>
  </Grid>
</Window>
