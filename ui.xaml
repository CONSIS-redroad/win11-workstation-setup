<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsisAI - stanowisko projektanta i kodu"
        Height="860" Width="520" MinHeight="680" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#131313" FontFamily="Segoe UI"
        Foreground="#E5E2E1">
  <Window.Resources>
    <Style TargetType="Button" x:Key="NavBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C0C7D4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PillBtn">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E5E2E1"/>
      <Setter Property="Margin" Value="0,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#202020" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="8" Background="#0078D4" VerticalAlignment="Center">
          <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="ConsisAI - stanowisko projektanta" FontSize="15" FontWeight="SemiBold" Foreground="#E5E2E1"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Name="txtHdrSubtitle" Text="Konfiguracja" FontSize="11" Foreground="#C0C7D4"/>
            <TextBlock Text="  ·  " FontSize="11" Foreground="#404752"/>
            <Border Background="#353535" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="ConsisAI" FontSize="10" Foreground="#74D1FF" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pages -->
    <Grid Grid.Row="1" Margin="16,12,16,8">
      <!-- CONFIG -->
      <ScrollViewer Name="pageConfig">
        <StackPanel>
          <Border Background="#202020" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="#2A2A2A">
                  <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#A3C9FF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Name="txtProfileName" Text="Brak profilu" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#3322874B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Aktywny profil" FontSize="11" Foreground="#7ADA95"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Name="txtProfileDesc" Text="" FontSize="12" Foreground="#C0C7D4" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              <ComboBox Name="cmbProfiles" Margin="0,10,0,0" Height="28"/>
              <TextBlock Text="Kim jestes? (zalecenia Consis - odhaczysz reszte)" Foreground="#A1A1AA" FontSize="11" Margin="0,10,0,3"/>
              <ComboBox Name="cmbRole" Height="28"/>
              <TextBlock Name="txtRoleBlurb" Text="" FontSize="11" Foreground="#74D1FF" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <WrapPanel Margin="0,10,0,0">
                <Border Background="#1B1C1C" CornerRadius="4" Padding="8,4" Margin="0,0,6,4">
                  <TextBlock Name="txtProfileFile" Text="—" FontSize="11" Foreground="#A3C9FF"/>
                </Border>
                <Border Background="#1B1C1C" CornerRadius="4" Padding="8,4" Margin="0,0,6,4">
                  <TextBlock Text="s.ps1" FontSize="11" Foreground="#74D1FF"/>
                </Border>
                <Border Background="#1B1C1C" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                  <TextBlock Name="txtHwInfo" Text="" FontSize="11" Foreground="#C0C7D4"/>
                </Border>
              </WrapPanel>
            </StackPanel>
          </Border>

          <UniformGrid Columns="2" Margin="0,0,0,10">
            <Border Background="#2A2A2A" CornerRadius="8" Padding="10" Margin="0,0,4,4">
              <StackPanel>
                <TextBlock Name="txtStatWinget" Text="0 pozycji" FontWeight="SemiBold"/>
                <TextBlock Text="Podstawa / PDF / 7-Zip" FontSize="11" Foreground="#C0C7D4"/>
              </StackPanel>
            </Border>
            <Border Background="#2A2A2A" CornerRadius="8" Padding="10" Margin="4,0,0,4">
              <StackPanel>
                <TextBlock Name="txtStatDirect" Text="0 pozycji" FontWeight="SemiBold"/>
                <TextBlock Text="Rola: CAD, AI, kod" FontSize="11" Foreground="#C0C7D4"/>
              </StackPanel>
            </Border>
            <Border Background="#2A2A2A" CornerRadius="8" Padding="10" Margin="0,4,4,0">
              <StackPanel>
                <TextBlock Name="txtStatTweaks" Text="0 tweaków" FontWeight="SemiBold"/>
                <TextBlock Text="Optymalizacja W11" FontSize="11" Foreground="#C0C7D4"/>
              </StackPanel>
            </Border>
            <Border Background="#2A2A2A" CornerRadius="8" Padding="10" Margin="4,4,0,0">
              <StackPanel>
                <TextBlock Text="Baza WinUtil" FontWeight="SemiBold"/>
                <TextBlock Name="txtStatWinUtil" Text="—" FontSize="11" Foreground="#C0C7D4"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <StackPanel Name="pnlAppSections"/>
          <TextBlock Name="txtWingetBadge" Visibility="Collapsed" Text="0/0"/>
          <TextBlock Name="txtDirectBadge" Visibility="Collapsed" Text="0/0"/>

          <Border Background="#202020" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Border Width="8" Height="16" Background="#7ADA95" CornerRadius="4" Margin="0,0,8,0"/>
                <TextBlock Name="txtTweakBadge" DockPanel.Dock="Right" Text="0 aktywne" FontSize="11" Foreground="#7ADA95" Padding="8,2"/>
                <TextBlock Text="Tweaki Windows 11" FontSize="16" FontWeight="SemiBold"/>
              </DockPanel>
              <StackPanel Name="pnlTweakItems"/>
            </StackPanel>
          </Border>

          <Border Background="#0E0E0E" CornerRadius="12" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Name="txtReadyLine" Text="Gotowy do wdrożenia" FontSize="12" Foreground="#7ADA95" Margin="0,0,0,4"/>
              <TextBox Name="txtLog" Height="72" Background="#0E0E0E" Foreground="#C0C7D4" BorderThickness="0"
                       FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
          </Border>

          <TextBlock Text="Przed kazda instalacja lub WinUtil (Auto) tworzymy punkt przywracania systemu. Przy 3+ pozycjach pojawi sie ostrzezenie."
                     FontSize="11" Foreground="#FFB86C" TextWrapping="Wrap" Margin="2,0,0,8"/>
          <Button Name="btnRunSelected" Style="{StaticResource PillBtn}" Background="#0078D4" Height="46" Margin="0,0,0,8"
                  Content="Zainstaluj zaznaczone z profilu"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="btnRunWinUtilAuto" Grid.Column="0" Style="{StaticResource PillBtn}" Background="#22874B" Height="40" Margin="0,0,4,0"
                    Content="WinUtil (Auto -Run)"/>
            <Button Name="btnOpenWinUtilGui" Grid.Column="1" Style="{StaticResource PillBtn}" Background="#2A2A2A" Height="40" Margin="4,0,0,0"
                    Content="WinUtil (Tylko GUI)"/>
          </Grid>
          <Button Name="btnScanQuick" Style="{StaticResource PillBtn}" Background="#202020" Height="36" Foreground="#C0C7D4" Margin="0,0,0,6"
                  Content="Wykonaj audyt systemu i tweakow (Pre-flight)"/>
          <Button Name="btnDumpEnv" Style="{StaticResource PillBtn}" Background="#2A2A2A" Height="36" Margin="0,0,0,6"
                  Content="Zrzut srodowiska do JSON (winget, pip, Cursor, Docker)"/>
          <Button Name="btnSystemImage" Style="{StaticResource PillBtn}" Background="#353535" Height="36"
                  Content="Zloty obraz dysku (backup na USB/SSD)"/>
        </StackPanel>
      </ScrollViewer>

      <!-- AUDIT -->
      <ScrollViewer Name="pageAudit" Visibility="Collapsed">
        <StackPanel>
          <Border Background="#202020" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Name="txtAuditHost" Text="—" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Name="txtAuditOs" Text="Uruchom audyt, aby pobrać stan maszyny" FontSize="12" Foreground="#C0C7D4"/>
              <TextBlock Name="txtAuditDate" Text="" FontSize="11" Foreground="#C0C7D4" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="#2A2A2A" CornerRadius="12" Padding="12" Margin="0,0,0,10">
            <TextBlock Name="txtAuditSummary" Text="Brak raportu" TextWrapping="Wrap"/>
          </Border>
          <TextBlock Text="Stan tweaków i rejestru" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8"/>
          <StackPanel Name="pnlAuditTweaks" Margin="0,0,0,12"/>
          <TextBlock Text="Wykryty bloatware (AppX)" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8"/>
          <StackPanel Name="pnlAuditAppx" Margin="0,0,0,12"/>
          <TextBlock Text="Stan usług systemowych" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8"/>
          <StackPanel Name="pnlAuditServices" Margin="0,0,0,12"/>
          <Button Name="btnRunAudit" Style="{StaticResource PillBtn}" Background="#0078D4" Height="42" Margin="0,0,0,8"
                  Content="Wygeneruj raport JSON"/>
          <Button Name="btnOpenAuditFile" Style="{StaticResource PillBtn}" Background="#353535" Height="38"
                  Content="Otwórz plik raportu"/>
        </StackPanel>
      </ScrollViewer>

      <!-- FILES -->
      <ScrollViewer Name="pageFiles" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Archiwum gotowe do wdrożenia" FontSize="12" Foreground="#7ADA95" Margin="2,4,0,8"/>
          <Border Background="#202020" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Pakiet konfiguracyjny" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Compress-Archive: ust_2.json, profil_*.json, skanuj.ps1, s.ps1, start.bat, ui.xaml" FontSize="11" Foreground="#C0C7D4" TextWrapping="Wrap" Margin="0,4,0,8"/>
              <TextBox Name="txtZipCmd" IsReadOnly="True" TextWrapping="Wrap" Background="#0E0E0E" Foreground="#74D1FF"
                       BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="8"/>
              <Button Name="btnCopyZip" Style="{StaticResource PillBtn}" Background="#353535" Height="36" Margin="0,8,0,0"
                      Content="Kopiuj polecenie ZIP"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Zawartość pakietu" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8"/>
          <StackPanel Name="pnlFileList"/>
          <Border Background="#202020" CornerRadius="12" Padding="12" Margin="0,10,0,10">
            <StackPanel>
              <TextBlock Name="txtInspectorTitle" Text="Inspektor" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Name="txtInspectorBody" Text="Kliknij plik na liście." FontSize="12" Foreground="#C0C7D4" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Button Name="btnMakeZip" Style="{StaticResource PillBtn}" Background="#0078D4" Height="42" Margin="0,0,0,8"
                  Content="Zbuduj Pakiet_Konfiguracyjny.zip"/>
          <Button Name="btnOpenFolder" Style="{StaticResource PillBtn}" Background="#2A2A2A" Height="38"
                  Content="Otwórz folder pakietu"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="pageLink" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Wklej link ze strony instalacji" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,4"/>
          <TextBlock Text="Program szuka pakietu w winget i instaluje cicho. Jak to plik .exe/.msi — pobiera i odpala /S. Wynik możesz dopisać do profilu JSON." FontSize="12" Foreground="#C0C7D4" TextWrapping="Wrap" Margin="2,0,0,10"/>
          <TextBox Name="txtLinkUrl" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"
                   Background="#1B1C1C" Foreground="#E5E2E1" BorderBrush="#404752" Padding="8"
                   FontSize="13"/>
          <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Name="cmbLinkSection" Height="32" Margin="0,0,8,0"/>
            <Button Name="btnLinkResolve" Grid.Column="1" Style="{StaticResource PillBtn}" Background="#0078D4" Height="32" Width="140"
                    Content="Szukaj w winget"/>
          </Grid>
          <TextBlock Name="txtLinkStatus" Text="Przyklad: https://git-scm.com  albo  Git.Git  albo link do setup.exe" FontSize="11" Foreground="#C0C7D4" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock Text="Kandydaci (kliknij, potem zapisz / zainstaluj)" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,6"/>
          <StackPanel Name="pnlLinkResults"/>
          <Button Name="btnLinkSave" Style="{StaticResource PillBtn}" Background="#22874B" Height="40" Margin="0,10,0,6"
                  Content="Dopisz do profilu JSON (bez instalacji)"/>
          <TextBlock Text="Instalacja z linku tez tworzy punkt przywracania przed zmiana."
                     FontSize="11" Foreground="#FFB86C" TextWrapping="Wrap" Margin="2,8,0,6"/>
          <Button Name="btnLinkInstall" Style="{StaticResource PillBtn}" Background="#0078D4" Height="40" Margin="0,0,0,6"
                  Content="Zainstaluj cicho (winget / EXE)"/>
          <Button Name="btnLinkBoth" Style="{StaticResource PillBtn}" Background="#2A2A2A" Height="38"
                  Content="Zapisz do JSON i zainstaluj"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="pageRun" Visibility="Collapsed">
        <StackPanel>
          <Border Background="#2A2A2A" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Name="txtRunTitle" Text="Wykonywanie profilu" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Name="txtRunStep" Text="Oczekiwanie..." FontSize="12" Foreground="#C0C7D4" Margin="0,4,0,8"/>
              <ProgressBar Name="barRun" Height="6" Minimum="0" Maximum="100" Value="0"/>
              <TextBlock Name="txtRunPct" Text="0%" FontSize="12" Foreground="#A3C9FF" Margin="0,6,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
          </Border>
          <Border Background="#0E0E0E" CornerRadius="12" Padding="10">
            <TextBox Name="txtRunLog" Height="420" Background="#0E0E0E" Foreground="#C0C7D4" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
          </Border>
          <Button Name="btnBackConfig" Style="{StaticResource PillBtn}" Background="#2A2A2A" Height="40" Margin="0,12,0,0"
                  Content="Wróć do konfiguracji"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Bottom nav -->
    <Border Grid.Row="2" Background="#202020" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
      <UniformGrid Columns="4" Margin="4,6">
        <Button Name="btnNavConfig" Style="{StaticResource NavBtn}" Background="#2A2A2A" Foreground="#A3C9FF">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="Konfig" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Name="btnNavLink" Style="{StaticResource NavBtn}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="Z linku" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Name="btnNavAudit" Style="{StaticResource NavBtn}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="Audyt" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
        <Button Name="btnNavFiles" Style="{StaticResource NavBtn}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="Pliki" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
      </UniformGrid>
    </Border>
  </Grid>
</Window>
